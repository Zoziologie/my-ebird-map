  "excluded": ["IND-2445", "TZA-3335", "BIH-4803", "SVN-245", "SVN-926"],
  "notes": {
    "AF": "Correct swapped Paktia/Paktika codes and split Parwan/Panjshir and Uruzgan/Daykundi using source GeoNames labels.",
    "AZ": "Correct Lachin mislabeled as Lankaran, separate district/city features and merge Nakhchivan districts.",
    "BA": "Merge Federation cantons and Republika Srpska districts; Posavina belongs to the Federation. Brcko remains excluded pending eBird treatment.",
    "BD": "Merge Rangpur back into the historical Rajshahi division used by eBird.",
    "BS": "Merge source districts to the combined island groups named by eBird.",
    "CN": "Explicit numeric-to-alphabetic province rekey; exclude unassigned/disputed island fragments.",
    "FI": "Merge Aland municipalities into FI-01; do not treat AX as a separate eBird country.",
    "HR": "Use the secondary English name to correct duplicated HR-12 (Pozega-Slavonia).",
    "IE": "Merge counties into the four historical provinces; IE-U includes only the Republic's Ulster counties.",
    "KR": "Correct Jeju/Sejong code collision and Gangwon rekey.",
    "KZ": "Separate Almaty province from Almaty city despite their duplicated source ISO code.",
    "LV": "Separate five districts from cities despite duplicated source codes, and correct swapped Sala/Salacgriva.",
    "MK": "Rekey municipalities and merge Drugovo, Oslomej, Vranestica and Zajas into Kicevo; source Skopje feature is Petrovec per GeoNames/FIPS.",
    "PR": "Use Natural Earth admin-2 municipios with explicit reviewed source feature IDs.",
    "RS": "Merge seven Vojvodina districts; Rasina source code/name requires review.",
    "TZ": "Replace the complete regional scheme with the 2019 NBS/geoBoundaries layer, including Mbeya/Songwe; explicit names avoid ISO code collisions. Nightly input is vendored with checksum.",
    "VN": "Merge the 63 source provinces into the 34 units used by eBird following the 2025 government reorganization.",
    "KI": "Assign the pinned source polygon components to Gilbert, Line and Phoenix island groups. No bounding rectangles are drawn.",
    "SC": "Separate Aldabra polygon components from the other Outer Islands. Perseverance is absent from the source.",
    "KY": "Assign the two separate sister-island polygons; Grand Cayman district boundaries remain unresolved.",
    "IN": "Separate the three disconnected source parts into Daman/Diu and Dadra/Nagar Haveli; retain actual land outlines.",
    "MV": "Separate Male from the incorrectly duplicated Meemu code; retain Alif Alif and Alif Dhaal as separate eBird codes.",
    "PH": "Use the 2020 province layer, merge NCR districts and reunite Isabela City with Basilan and Cotabato City with Maguindanao.",
    "SI": "Replace the source Kostel/Osilnica and Cankova/Tisina combined outlines with four OSM municipality polygons; merge Apace back into historical Gornja Radgona."
  },
  "deferred": {
    "DK": "eBird uses 13 regions; the source uses five. Resolve the historical/custom geography before matching.",
    "LY": "eBird uses 34 historical districts; available source layers use 22 modern districts. Do not substitute one for the other.",
    "QA": "eBird uses nine historical municipalities; available source layers use a different seven/eight-municipality scheme.",
    "MU": "Cargados Carajos Shoals are absent from the prepared land geometry.",
    "SC": "Perseverance is reclaimed land absent from the older source; a newer outline is needed.",
    "UM": "Kingman Reef has no source land polygon; do not invent a rectangle for a reef."
  },
