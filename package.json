{
  "name": "myebirdmap",
  "version": "2.0.0",
  "description": "Visualize all your eBird observations on a map!",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-app.mjs",
    "benchmark": "node scripts/benchmark-map.mjs",
    "prepare:local": "node scripts/prepare-local.mjs",
    "review:taxonomy": "node --env-file=.env scripts/review-taxonomy.mjs",
    "check:build": "node scripts/check-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run check && node --test tests/*.test.js",
    "prepare:cases": "python3 scripts/prepare-export-cases.py",
    "test:export": "node scripts/check-export.mjs",
    "benchmark:export": "node scripts/benchmark-export.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoziologie/myebirdmap.git"
  },
  "private": true,
  "type": "module",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zoziologie/myebirdmap/issues"
  },
  "homepage": "https://zoziologie.raphaelnussbaumer.com/myebirdmap/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0",
    "bootstrap-icons": "^1.13.1",
    "papaparse": "^5.5.3",
    "supercluster": "^9.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
